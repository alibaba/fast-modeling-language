<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <typeAliases>
        <typeAlias alias="ShowTables" type="com.aliyun.fastmodel.driver.server.mybatis.ShowTables"/>
    </typeAliases>
    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="com.aliyun.fastmodel.driver.client.FastModelEngineDriver"/>
                <property name="url" value="jdbc:fastmodel://localhost:8082/dataworks?ssl=false&amp;path=jdbc"/>
            </dataSource>
        </environment>
    </environments>
    <mappers>
        <mapper resource="mybatis/mapper/ShowTablesMapper.xml"/>
    </mappers>
</configuration>